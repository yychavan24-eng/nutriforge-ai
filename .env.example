# NutriForge AI - Backend Environment Configuration Example
# Copy this file to .env in your backend directory or set these in your shell.

# Google Gemini API Key for Live Food-Label Vision OCR
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Multimodal Vision Model (default: gemini-2.5-flash)
# Supported recommended models: gemini-2.5-flash, gemini-3.7-flash
GEMINI_MODEL=gemini-2.5-flash

# Database URL (default: sqlite:///./nutriforge.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/nutriforge
