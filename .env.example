# NutriForge AI - Environment Configuration Example

# ----------------------------------------------------
# Backend Configuration
# ----------------------------------------------------
# Google Gemini API Key for Live Food-Label Vision OCR
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Multimodal Vision Model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Database URL
# Default in development: sqlite:///./nutriforge.db
# Production recommendation (Render Postgres, Supabase, Neon, Railway):
# DATABASE_URL=postgresql://user:password@host:5432/nutriforge
DATABASE_URL=sqlite:///./nutriforge.db

# Allowed CORS Origins (comma-separated list for production, or * for open development)
# Example: ALLOWED_ORIGINS=https://nutriforge.onrender.com,https://nutriforge.vercel.app
ALLOWED_ORIGINS=*

# Server Port (automatically assigned by hosting platforms such as Render, Heroku, Railway)
PORT=8000

# ----------------------------------------------------
# Frontend Configuration
# ----------------------------------------------------
# Backend API Base URL for React app
# In production, set to your public backend service URL (e.g. https://nutriforge-backend.onrender.com)
VITE_API_URL=http://localhost:8000
